- name: soapy_bladerf_sink_0
  id: soapy_bladerf_sink
  parameters:
    affinity: ''
    alias: ''
    bandwidth: '0.0'
    center_freq: (band * 1e6 + 100000 - offset) * (1 + correction*1e-6)
